# Copier en .env.local (web/admin) ou .env (api). Aucune valeur réelle ici.
# --- Web public (apps/web) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "demo" affiche les données de démonstration (badgées) ; "production" ne publie que les données VERIFIED.
NEXT_PUBLIC_CONTENT_MODE=demo
API_BASE_URL=http://localhost:8000
# --- API (services/api) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://para:para_dev@localhost:5432/para_official
SECRET_KEY=change-me-in-each-environment
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Stockage S3 compatible (médias) — à configurer par environnement
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
